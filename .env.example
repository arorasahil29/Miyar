# Copy to .env and fill in. Never commit .env.

# Where people open Basira. Use https:// in production (cookies are then marked Secure).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
ORG_NAME=My organisation

# Secrets: generate each with  openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
BASIRA_GATEWAY_KEY=

# Sign-in with any OpenID Connect provider. Register an app with redirect URI  <PUBLIC_URL>/auth/callback
#   Microsoft Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google:             https://accounts.google.com
#   Okta:               https://<your-domain>.okta.com   (or .../oauth2/default)
#   Keycloak:           https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=your company account

# Roles. Listed emails are always admins. Otherwise new people get DEFAULT_ROLE and an admin can change it.
ADMIN_EMAILS=
DEFAULT_ROLE=viewer
# Optional: take roles from identity-provider groups instead (checked at every sign-in)
OIDC_ROLE_CLAIM=groups
ADMIN_GROUPS=
EDITOR_GROUPS=
# Optional: only allow these email domains, e.g. example.com
ALLOWED_EMAIL_DOMAINS=

# File storage for uploaded datasets: "local" (a Docker volume) or "s3" (AWS S3, Azure via S3 gateway, MinIO, Cloudflare R2...)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# For a quick local trial without an identity provider (everyone becomes an administrator; never use in production):
# AUTH_MODE=dev
